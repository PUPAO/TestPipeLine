# ==========================================
# 1. PostgreSQL (pgvector)
# ==========================================
POSTGRES_USER=incident_user
POSTGRES_PASSWORD=incident_pass
POSTGRES_DB=incident_db

# ==========================================
# 2. 무료 LLM API Keys (카드 등록 불필요)
# ==========================================
# 경량 에러 분류 & 도메인 태그 추출용 (https://console.groq.com)
GROQ_API_KEY=gsk_your_groq_api_key_here

# 근본 원인 분석 & Git Diff 패치 생성용 (https://aistudio.google.com)
GEMINI_API_KEY=AIza_your_gemini_api_key_here

# ==========================================
# 3. Discord Bot & 알림 채널
# ==========================================
# Discord Developer Portal -> Bot Token (Message Content Intent 활성화 필수)
DISCORD_BOT_TOKEN=your_discord_bot_token_here
# 장애 알림 메시지가 올라오는 채널 우클릭 -> 채널 ID 복사
DISCORD_ALERT_CHANNEL_ID=123456789012345678

# ==========================================
# 4. 타겟 Spring Boot GitHub 저장소
# ==========================================
# repo 권한이 포함된 GitHub Personal Access Token (Fine-grained 또는 Classic)
GITHUB_TOKEN=ghp_your_github_token_here
TARGET_REPO_OWNER=your-github-username
TARGET_REPO_NAME=remine-backend
TARGET_BASE_BRANCH=main

# ==========================================
# 5. 파이프라인 제어 및 무료 한도 방어 설정
# ==========================================
DEDUP_TTL_SECONDS=600
MAX_PATCH_RETRIES=3
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
